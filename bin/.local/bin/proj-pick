#!/usr/bin/env bash
# proj-pick — fzf over directories in $PROJECTS_DIR; prints the selected path.
# Used by the `gp` alias, which cds into the result.
set -euo pipefail

dir="${PROJECTS_DIR:-$HOME/projects}"

if [[ ! -d "$dir" ]]; then
  echo "proj-pick: $dir does not exist" >&2
  exit 1
fi
command -v fzf >/dev/null || { echo "proj-pick: fzf not installed" >&2; exit 1; }

find "$dir" -mindepth 1 -maxdepth 1 -type d ! -name '.*' | sort |
  fzf --prompt='project> ' \
      --delimiter='/' --with-nth=-1 \
      --height=50% --reverse --border \
      --query="${1:-}" --select-1 \
      --preview='git -C {} log --oneline --color=always -10 2>/dev/null; echo; ls -A {}'
